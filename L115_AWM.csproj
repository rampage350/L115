<Project Sdk="Microsoft.NET.Sdk">
  <!-- SPT 4.1.x -> .NET 10 -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>L115_AWM</AssemblyName>
    <RootNamespace>L115AWM</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <!-- WTT-ServerCommonLib.dll is searched in: this folder, libs\, or pass /p:WttDll="full\path\WTT-ServerCommonLib.dll" -->
    <WttDll Condition="'$(WttDll)' == '' And Exists('$(MSBuildProjectDirectory)\WTT-ServerCommonLib.dll')">$(MSBuildProjectDirectory)\WTT-ServerCommonLib.dll</WttDll>
    <WttDll Condition="'$(WttDll)' == '' And Exists('$(MSBuildProjectDirectory)\libs\WTT-ServerCommonLib.dll')">$(MSBuildProjectDirectory)\libs\WTT-ServerCommonLib.dll</WttDll>
    <WttDll Condition="'$(WttDll)' == '' And Exists('$(MSBuildProjectDirectory)\libs\WTTServerCommonLib.dll')">$(MSBuildProjectDirectory)\libs\WTTServerCommonLib.dll</WttDll>
  </PropertyGroup>

  <ItemGroup>
    <!-- SPT 4.1.x from NuGet (compile-time only, not copied to the output) -->
    <PackageReference Include="SPTarkov.Server.Core" Version="4.1.*" ExcludeAssets="runtime" />
    <PackageReference Include="SPTarkov.DI" Version="4.1.*" ExcludeAssets="runtime" />
    <PackageReference Include="SPTarkov.Common" Version="4.1.*" ExcludeAssets="runtime" />
    <Reference Include="WTTServerCommonLib"><HintPath>$(WttDll)</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <!-- copy the data folders next to the dll in the output -->
  <ItemGroup>
    <None Include="db\**\*.json" CopyToOutputDirectory="PreserveNewest" LinkBase="." />
    <None Include="bundles\**\*" CopyToOutputDirectory="PreserveNewest" LinkBase="." />
    <None Include="bundles.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="config.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="CheckWtt" BeforeTargets="ResolveAssemblyReferences" Condition="'$(WttDll)' == ''">
    <Error Text="WTT-ServerCommonLib.dll not found. Copy it from SPT\user\mods\WTT-ServerCommonLib\ into $(MSBuildProjectDirectory)\ (next to this csproj) or into $(MSBuildProjectDirectory)\libs\." />
  </Target>
</Project>
